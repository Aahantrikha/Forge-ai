{
  "name": "forge-ai",
  "productName": "Forge AI",
  "description": "Local-first, open-source desktop AI coding environment for Windows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/prepare-sqlite.cjs",
    "rebuild": "node scripts/prepare-sqlite.cjs"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.19.6",
    "better-sqlite3": "^12.11.1",
    "opencode-ai": "^1.19.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9"
  },
  "main": "dist-electron/main.js",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@30.5.1": true,
    "esbuild@0.21.5": true,
    "opencode-ai@1.19.6": true
  }
}
